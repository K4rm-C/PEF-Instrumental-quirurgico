msgid "Choose a valid status."
msgstr "Elige un estado válido."

#: services/admin_local/messages.py:30 services/admin_local/messages.py:32
msgid "Code, name and category are required."
msgstr "El código, el nombre y la categoría son obligatorios."

#: services/admin_local/messages.py:31
msgid "Name is required."
msgstr "El nombre es obligatorio."

#: services/admin_local/messages.py:33
msgid "Choose a valid category."
msgstr "Elige una categoría válida."

#: services/admin_local/messages.py:34
msgid "That family code already exists."
msgstr "Ese código de familia ya existe."

#: services/admin_local/messages.py:36
msgid "Internal code is required."
msgstr "El código interno es obligatorio."

#: services/admin_local/messages.py:37
msgid "Internal code must contain at most 64 characters."
msgstr "El código interno debe tener como máximo 64 caracteres."

#: services/admin_local/messages.py:38 services/admin_local/messages.py:39
msgid "Instrument family and cycle status are required."
msgstr "La familia de instrumentos y el estado de ciclo son obligatorios."

#: services/admin_local/messages.py:40
msgid "Choose a valid instrument family and cycle status."
msgstr "Elige una familia de instrumentos y un estado de ciclo válidos."

#: services/admin_local/messages.py:41
msgid "An instrument with this internal code already exists for the institution."
msgstr "Ya existe un instrumento con este código interno en la institución."

#: services/admin_local/messages.py:42
msgid "A change reason is required when cycle status or active status changes."
msgstr "Se requiere un motivo de cambio cuando cambia el estado de ciclo o el estado activo."

#: services/admin_local/messages.py:44
msgid "A kit with this name and version already exists for the institution."
msgstr "Ya existe un kit con este nombre y versión en la institución."

#: services/admin_local/messages.py:45
msgid "Choose a valid instrument family and quantity for every row."
msgstr "Elige una familia de instrumentos y una cantidad válidas en cada fila."

#: services/admin_local/messages.py:46
msgid "Expected quantity must be between 1 and 32767."
msgstr "La cantidad esperada debe estar entre 1 y 32767."

#: services/admin_local/messages.py:47
msgid "An instrument family can only appear once in the composition."
msgstr "Una familia de instrumentos solo puede aparecer una vez en la composición."

#: services/admin_local/messages.py:48
msgid "Add at least one instrument family to the kit composition."
msgstr "Agrega al menos una familia de instrumentos a la composición del kit."

#: services/admin_local/messages.py:49
msgid "Choose instrument families from the available catalog."
msgstr "Elige familias de instrumentos del catálogo disponible."

#: services/admin_local/messages.py:51
msgid "A procedure with this code already exists."
msgstr "Ya existe un procedimiento con este código."

#: services/admin_local/messages.py:52
msgid "Choose a valid kit for every associated kit row."
msgstr "Elige un kit válido en cada fila de kits asociados."

#: services/admin_local/messages.py:53
msgid "A kit can only be associated once."
msgstr "Un kit solo puede asociarse una vez."

#: services/admin_local/messages.py:54
msgid "Choose at most one default kit."
msgstr "Elige como máximo un kit predeterminado."

#: services/admin_local/messages.py:55
msgid "The default kit must be an active association."
msgstr "El kit predeterminado debe ser una asociación activa."

#: services/admin_local/messages.py:56
msgid "Choose kits and phases from the available catalogs."
msgstr "Elige kits y fases de los catálogos disponibles."

#: services/admin_local/messages.py:57
msgid "Choose a valid phase for every counting phase row."
msgstr "Elige una fase válida en cada fila de fases de conteo."

#: services/admin_local/messages.py:58
msgid "Phase order must be between 1 and 32767."
msgstr "El orden de la fase debe estar entre 1 y 32767."

#: services/admin_local/messages.py:59
msgid "A phase can only be added once."
msgstr "Una fase solo puede agregarse una vez."

#: services/admin_local/messages.py:60
msgid "Each counting phase must have a unique order."
msgstr "Cada fase de conteo debe tener un orden único."

#: services/admin_local/messages.py:62 services/admin_local/messages.py:63
msgid "Name, email, and institution are required."
msgstr "El nombre, el correo electrónico y la institución son obligatorios."

#: services/admin_local/messages.py:64
msgid "Enter a valid email address."
msgstr "Ingresa un correo electrónico válido."

#: services/admin_local/messages.py:65 services/admin_local/messages.py:68
msgid "Choose a valid institution and at least one role assigned to it."
msgstr "Elige una institución válida y al menos un rol asignado a ella."

#: services/admin_local/messages.py:66
msgid "Users cannot be added to an inactive institution."
msgstr "No se pueden agregar usuarios a una institución inactiva."

#: services/admin_local/messages.py:67
msgid "Assign at least one role."
msgstr "Asigna al menos un rol."

#: services/admin_local/messages.py:69
msgid "A user with this email already exists."
msgstr "Ya existe un usuario con este correo electrónico."

#: services/admin_local/messages.py:70
msgid "Password must contain at least 8 characters."
msgstr "La contraseña debe tener al menos 8 caracteres."

#: services/admin_local/messages.py:71 templates/admin/users/form.html:62
msgid "Passwords do not match."
msgstr "Las contraseñas no coinciden."

#: services/admin_local/messages.py:72 templates/admin/users/form.html:135
msgid "You cannot deactivate your own account."
msgstr "No puedes desactivar tu propia cuenta."

#: services/admin_local/messages.py:73
msgid "You cannot remove the administrator role from your own account."
msgstr "No puedes quitar el rol de administrador de tu propia cuenta."

#: services/admin_local/messages.py:74
msgid "At least one active administrator must remain."
msgstr "Debe quedar al menos un administrador activo."

#: services/admin_local/messages.py:76
msgid "A role with this code already exists for the institution."
msgstr "Ya existe un rol con este código en la institución."

#: services/admin_local/messages.py:77
msgid "Role code may only contain lowercase letters, numbers and underscores."
msgstr "El código del rol solo puede contener letras minúsculas, números y guiones bajos."

#: services/admin_local/messages.py:78
msgid "Description is required."
msgstr "La descripción es obligatoria."

#: services/admin_local/messages.py:79 templates/admin/roles/form.html:105
msgid "System roles cannot be deleted."
msgstr "Los roles del sistema no se pueden eliminar."

#: services/admin_local/messages.py:80 templates/admin/roles/form.html:107
msgid "Remove this role from every user before deleting it."
msgstr "Quita este rol a todos los usuarios antes de eliminarlo."

#: services/admin_local/messages.py:82
msgid "Version tag is required."
msgstr "La etiqueta de versión es obligatoria."

#: services/admin_local/messages.py:83
msgid "A vision model with this version tag already exists."
msgstr "Ya existe un modelo de visión con esta etiqueta de versión."

#: services/admin_local/messages.py:84
msgid "Checksum must be a 64-character SHA-256 hex value."
msgstr "El checksum debe ser un valor SHA-256 hexadecimal de 64 caracteres."

#: services/admin_local/messages.py:85
msgid "YOLO class IDs must be whole numbers from 0."
msgstr "Los IDs de clase YOLO deben ser números enteros desde 0."

#: services/admin_local/messages.py:86
msgid "Each YOLO class ID can only be mapped once."
msgstr "Cada ID de clase YOLO solo se puede mapear una vez."

#: services/admin_local/messages.py:87
msgid "Each instrument family can only be mapped once per model."
msgstr "Cada familia de instrumentos solo se puede mapear una vez por modelo."

#: services/admin_local/messages.py:88
msgid "Map at least one YOLO class before activating a model."
msgstr "Mapea al menos una clase YOLO antes de activar un modelo."

#: services/admin_local/messages.py:89
#: templates/admin/vision_models/form.html:62
msgid "The class mapping of the active model cannot be changed. Register a new version instead."
msgstr "El mapeo de clases del modelo activo no se puede cambiar. Registra una nueva versión."

#: services/admin_local/messages.py:91
msgid "You cannot deactivate the institution your account belongs to."
msgstr "No puedes desactivar la institución a la que pertenece tu cuenta."

#: services/admin_local/messages.py:92
msgid "An operating room with this code already exists."
msgstr "Ya existe un quirófano con este código."

#: services/admin_local/messages.py:95
msgid "Use the YYYY-MM-DD date format."
msgstr "Usa el formato de fecha AAAA-MM-DD."

#: services/admin_local/messages.py:113
msgid "Fill in every required field."
msgstr "Completa todos los campos obligatorios."

#: services/admin_local/messages.py:115
msgid "One of the fields is too long."
msgstr "Uno de los campos es demasiado largo."

