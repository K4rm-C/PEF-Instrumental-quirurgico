#: services/rf_session.py:185
msgid "Could not start session; please retry."
msgstr "No se pudo iniciar la sesión; inténtalo de nuevo."

#: services/rf_session.py:214 services/rf_session.py:400
msgid "Session is not in progress."
msgstr "La sesión no está en progreso."

#: services/rf_session.py:217
msgid "Quantity report is not allowed for this capture mode."
msgstr "El reporte de cantidades no está permitido para este modo de captura."

#: services/rf_session.py:223
msgid "Session has no expected inventory."
msgstr "La sesión no tiene inventario esperado."

#: services/rf_session.py:227
msgid "Report must include every expected family exactly once."
msgstr "El reporte debe incluir cada familia esperada exactamente una vez."

#: services/rf_session.py:241
msgid "Reported quantity must be >= 0."
msgstr "La cantidad reportada debe ser >= 0."

#: services/rf_session.py:246 templates/operator/sessions/manual_report.html:88
msgid "Reason is required when reported quantity differs from expected."
msgstr "El motivo es obligatorio cuando la cantidad reportada difiere de la esperada."

#: services/rf_session.py:248
msgid "Notes must have at least 10 characters when reason is Other."
msgstr "Las notas deben tener al menos 10 caracteres cuando el motivo es Otro."

#: services/rf_session.py:341
msgid "Could not submit report; please retry."
msgstr "No se pudo enviar el reporte; inténtalo de nuevo."

#: services/rf_session.py:403
msgid "Unknown phase code."
msgstr "Código de fase desconocido."

#: services/rf_session.py:428
msgid "Could not change phase; please retry."
msgstr "No se pudo cambiar la fase; inténtalo de nuevo."

#: services/rf_session.py:614
msgid "Could not persist board auto count."
msgstr "No se pudo guardar el conteo automático del tablero."

#: services/rf_session.py:699
msgid "Vision finish is not available for this session."
msgstr "La finalización por visión no está disponible para esta sesión."

#: services/rf_session.py:800
msgid "At least one physician is required."
msgstr "Se requiere al menos un médico."

#: services/rf_session.py:808
msgid "Each surgical team row needs a physician."
msgstr "Cada fila del equipo quirúrgico necesita un médico."

#: services/rf_session.py:811
msgid "Each physician can only be selected once."
msgstr "Cada médico solo puede seleccionarse una vez."

#: services/rf_session.py:815
msgid "Choose a valid physician."
msgstr "Elige un médico válido."

#: services/rf_session.py:847 services/rf_session.py:1044
msgid "Choose a valid operator."
msgstr "Elige un operador válido."

#: services/rf_session.py:854 services/rf_session.py:1051
msgid "Assigned user must have station_operator role."
msgstr "El usuario asignado debe tener el rol station_operator."

#: services/rf_session.py:861 services/rf_session.py:961
#: services/rf_session.py:1057
msgid "Expected quantities must be >= 1."
msgstr "Las cantidades esperadas deben ser >= 1."

#: services/rf_session.py:864 services/rf_session.py:964
#: services/rf_session.py:1060
msgid "Stock BLOCK: requested quantity exceeds available instruments."
msgstr "Existencias BLOCK: la cantidad solicitada excede los instrumentos disponibles."

#: services/rf_session.py:868
msgid "Invalid initial phase."
msgstr "Fase inicial no válida."

#: services/rf_session.py:927
msgid "Could not schedule session; please retry."
msgstr "No se pudo programar la sesión; inténtalo de nuevo."

#: services/rf_session.py:945
msgid "Inventory can only be modified while scheduled or in progress."
msgstr "El inventario solo puede modificarse mientras la sesión está programada o en progreso."

#: services/rf_session.py:947
msgid "Provide at least one inventory line."
msgstr "Proporciona al menos una línea de inventario."

#: services/rf_session.py:1011
msgid "Could not update session inventory; please retry."
msgstr "No se pudo actualizar el inventario de la sesión; inténtalo de nuevo."

#: services/rf_session.py:1037
msgid "Full session edit is only available while scheduled."
msgstr "La edición completa de la sesión solo está disponible mientras está programada."

#: services/rf_session.py:1040
msgid "Session operation not found."
msgstr "No se encontró la operación de la sesión."

#: services/rf_session.py:1129
msgid "Could not update scheduled session; please retry."
msgstr "No se pudo actualizar la sesión programada; inténtalo de nuevo."

#: services/rf_session.py:1148
msgid "Privacy agreement can only be set while session is scheduled."
msgstr "El acuerdo de privacidad solo puede establecerse mientras la sesión está programada."

#: services/rf_session.py:1150
msgid "Capture mode already frozen; cannot change privacy agreement."
msgstr "El modo de captura ya está congelado; no se puede cambiar el acuerdo de privacidad."

#: services/rf_session.py:1154
msgid "Choose an active privacy notice version."
msgstr "Elige una versión activa del aviso de privacidad."

#: services/rf_session.py:1187
msgid "Could not confirm privacy notice; please retry."
msgstr "No se pudo confirmar el aviso de privacidad; inténtalo de nuevo."

#: services/rf_session.py:1370
msgid "Choose Lost or Recovered, not both."
msgstr "Elige Perdido o Recuperado, no ambos."

#: services/rf_session.py:1372
msgid "Resolution notes are required."
msgstr "Las notas de resolución son obligatorias."

#: services/rf_session.py:1376
msgid "Discrepancy not found."
msgstr "No se encontró la discrepancia."

#: services/rf_session.py:1378
msgid "Discrepancy already resolved."
msgstr "La discrepancia ya está resuelta."

#: services/rf_session.py:1475
msgid "Could not resolve discrepancy; please retry."
msgstr "No se pudo resolver la discrepancia; inténtalo de nuevo."

#: services/rf_session.py:1494
msgid "Confirm material recovered / reprocessing started."
msgstr "Confirma que el material se recuperó / que inició el reprocesamiento."

#: services/rf_session.py:1500
msgid "Session is not awaiting SPD review."
msgstr "La sesión no está esperando revisión de SPD."

#: services/rf_session.py:1508
msgid "Resolve open discrepancies before closing."
msgstr "Resuelve las discrepancias abiertas antes de cerrar."

#: services/rf_session.py:1558
msgid "Could not close session; please retry."
msgstr "No se pudo cerrar la sesión; inténtalo de nuevo."

