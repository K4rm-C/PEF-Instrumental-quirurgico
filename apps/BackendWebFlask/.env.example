# Use DATABASE_URL instead of the individual DB_* variables when preferred.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pecausas

# Used when DATABASE_URL is not set.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pecausas
DB_USER=postgres
DB_PASSWORD=change-me

# Required for signed Flask sessions outside local development.
SESSION_SECRET_KEY=change-me