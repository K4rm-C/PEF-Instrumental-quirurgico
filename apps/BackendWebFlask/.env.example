# Use DATABASE_URL instead of the individual DB_* variables when preferred.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pecausas

# Used when DATABASE_URL is not set.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pecausas
DB_USER=postgres
DB_PASSWORD=change-me

# Required for signed Flask sessions outside local development.
SESSION_SECRET_KEY=change-me

# Development-only view-data fallback. Authentication still uses BackendAuthService.
FRONTEND_DEMO_MODE=false

AUTH_SERVICE_URL=http://127.0.0.1:5001
AUTH_SERVICE_TIMEOUT=5

# Private local storage for session capture evidence (JPEG). Leave empty to use
# apps/BackendWebFlask/instance/evidence (git-ignored, not served as static files).
CAPTURE_STORAGE_ROOT=
CAPTURE_STORAGE_BUCKET=pef-evidence
CAPTURE_MAX_BYTES=10485760

# Vision inference. 'controlled' is the development provider (no real YOLO runtime yet).
VISION_INFERENCE_PROVIDER=controlled
VISION_CONFIDENCE_THRESHOLD=0.70
