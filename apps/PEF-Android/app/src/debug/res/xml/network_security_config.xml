<?xml version="1.0" encoding="utf-8"?>
<!-- SOLO compilaciones debug: HTTP en claro limitado a los destinos de desarrollo local.
     - 10.0.2.2: la máquina anfitriona vista desde el emulador estándar (Gateway en :8080).
     - localhost / 127.0.0.1: con `adb reverse tcp:8080 tcp:8080` (teléfono físico o emulador)
       y URLs prefirmadas de evidencias de Garage (S3_PUBLIC_ENDPOINT, :3900).
     Para usar la IP LAN de la computadora agregue aquí un <domain> con esa IP (ver README.md).
     Todo lo demás sigue exigiendo HTTPS con validación normal de certificados. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
