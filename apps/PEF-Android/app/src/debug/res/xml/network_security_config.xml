<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG builds ONLY: cleartext HTTP ok for lab (flexible LAN IP + 10.0.2.2 + loopback).
     host IP moves when you change networks, so debug base-config doesnt hardcode domains.
     release stays in src/main with cleartext off + HTTPS required.
     set URL via scripts/pef_lan_endpoint.ps1 -> pef.apiBaseUrl.debug. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
