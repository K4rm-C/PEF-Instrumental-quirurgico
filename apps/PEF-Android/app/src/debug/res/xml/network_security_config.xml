<?xml version="1.0" encoding="utf-8"?>
<!-- SOLO compilaciones debug: HTTP en claro permitido para lab (LAN IP flexible + 10.0.2.2 + loopback).
     La IP del host cambia al cambiar de red; por eso el base-config debug no lista dominios fijos.
     Release sigue en src/main con cleartext deshabilitado y HTTPS obligatorio.
     Configurar URL con scripts/pef_lan_endpoint.ps1 → pef.apiBaseUrl.debug. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
