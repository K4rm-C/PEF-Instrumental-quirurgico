<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+. Las preferencias de interfaz pueden respaldarse; la sesión cifrada (JWT) no. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/pef_secure_session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/pef_secure_session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
