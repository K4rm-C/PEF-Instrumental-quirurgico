<?xml version="1.0" encoding="utf-8"?>
<!-- Release / base config: HTTPS only + system CAs only.
     TLS validation never turned off. local cleartext HTTP lives under src/debug. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
