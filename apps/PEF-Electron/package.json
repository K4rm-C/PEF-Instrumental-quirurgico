{
  "name": "pef-electron-monitor",
  "productName": "PEF Monitor",
  "version": "0.1.0",
  "description": "PEF - monitor visual de instrumental quirurgico (semaforo) para estaciones de conteo",
  "private": true,
  "license": "MIT",
  "author": "PEF UDEM",
  "main": "dist/main/main.js",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "icons": "node scripts/make-icons.mjs",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run clean && npm run icons && npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "start": "electron .",
    "dev": "npm run build && electron . --dev",
    "demo": "npm run build && electron . --demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "npm run build && electron . --smoke-test",
    "dist:dir": "npm run build && electron-builder --win dir",
    "dist:win": "npm run build && electron-builder --win nsis",
    "test:electron": "node scripts/electron-tests.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "44.10.1",
    "electron-builder": "26.0.20",
    "playwright-core": "1.64.1",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "3.2.7",
    "ws": "8.18.3"
  }
}
