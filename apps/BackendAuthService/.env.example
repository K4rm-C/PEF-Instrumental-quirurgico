# Use DATABASE_URL instead of the individual DB_* variables when preferred.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pecausas

# Used when DATABASE_URL is not set.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pecausas
DB_USER=postgres
DB_PASSWORD=change-me

# JWT signing and token lifetimes.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
RESET_TOKEN_MINUTES=30

# Set false when reset tokens are delivered by email/SMS instead of the API.
AUTH_RETURN_RESET_TOKEN=true
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=true

HOST=0.0.0.0
PORT=5001