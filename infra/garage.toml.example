# Plantilla de desarrollo: generar infra/garage.toml con python scripts/prepare_local.py.
metadata_dir = "/var/lib/garage/meta"
data_dir = "/var/lib/garage/data"
db_engine = "sqlite"
replication_factor = 1

rpc_bind_addr = "[::]:3901"
rpc_public_addr = "127.0.0.1:3901"
rpc_secret = "REEMPLAZAR_CON_64_CARACTERES_HEXADECIMALES"

[s3_api]
s3_region = "garage"
api_bind_addr = "[::]:3900"
root_domain = ".s3.garage.localhost"

[s3_web]
bind_addr = "[::]:3902"
root_domain = ".web.garage.localhost"
index = "index.html"

[admin]
api_bind_addr = "[::]:3903"
admin_token = "REEMPLAZAR_TOKEN_ADMIN"
metrics_token = "REEMPLAZAR_TOKEN_METRICAS"
