# Generated by scripts/generate_vm_deploy.py (MS-09). Install: /etc/systemd/system/pef-integration-worker.service
[Unit]
Description=PEF IntegrationService worker (FHIR deliveries)
After=network-online.target postgresql.service redis.service valkey.service
Wants=network-online.target
# Controlled restarts: at most 5 restarts in 5 minutes, then the unit stays failed (alert, no restart storm).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=pef-svc
Group=pef
WorkingDirectory=/opt/pef/current/apps/IntegrationService
EnvironmentFile=/etc/pef/common.env
EnvironmentFile=/etc/pef/integration.env
ExecStart=/opt/pef/venvs/IntegrationService/bin/python worker.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
KillSignal=SIGTERM
# Logs: journald (journalctl -u pef-integration-worker); never tokens or secrets (the services do not log them).
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pef-integration-worker
# Hardening (no root, read-only system, private /tmp, no privilege escalation).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/pef/run
UMask=0027

[Install]
WantedBy=multi-user.target
