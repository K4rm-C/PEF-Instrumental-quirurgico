# Generated by scripts/generate_vm_deploy.py (MS-09). Install: /etc/systemd/system/pef-vision.service
[Unit]
Description=PEF VisionWorker (YOLO inference, live WebSocket)
After=network-online.target postgresql.service redis.service valkey.service
Wants=network-online.target
# Controlled restarts: at most 5 restarts in 5 minutes, then the unit stays failed (alert, no restart storm).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=pef-vision
Group=pef
WorkingDirectory=/opt/pef/current/apps/VisionWorker
EnvironmentFile=/etc/pef/common.env
EnvironmentFile=/etc/pef/vision.env
ExecStart=/opt/pef/venvs/VisionWorker/bin/gunicorn --bind 127.0.0.1:5002 --workers 1 --threads 8 --timeout 600 --graceful-timeout 60 main:app
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
KillSignal=SIGTERM
# Logs: journald (journalctl -u pef-vision); never tokens or secrets (the services do not log them).
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pef-vision
# Hardening (no root, read-only system, private /tmp, no privilege escalation).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/pef/vision
UMask=0027

[Install]
WantedBy=multi-user.target
