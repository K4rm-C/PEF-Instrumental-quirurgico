# Generated by scripts/generate_vm_deploy.py (MS-09). Install: /etc/systemd/system/pef-audit.service
[Unit]
Description=PEF AuditService
After=network-online.target postgresql.service redis.service valkey.service
Wants=network-online.target
# Controlled restarts: at most 5 restarts in 5 minutes, then the unit stays failed (alert, no restart storm).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=pef-svc
Group=pef
WorkingDirectory=/opt/pef/current/apps/AuditService
EnvironmentFile=/etc/pef/common.env
EnvironmentFile=/etc/pef/audit.env
ExecStart=/opt/pef/venvs/AuditService/bin/gunicorn --bind 127.0.0.1:5006 --workers 2 'main:create_app()'
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
KillSignal=SIGTERM
# Logs: journald (journalctl -u pef-audit); never tokens or secrets (the services do not log them).
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pef-audit
# Hardening (no root, read-only system, private /tmp, no privilege escalation).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/pef/run
UMask=0027

[Install]
WantedBy=multi-user.target
