# /etc/pef/vision.env (root:pef 0640). Example only: no real value is committed.
VISION_WORKER_PORT=5002
VISION_WS_SECRET=<same as the portal>
VISION_WS_ORIGINS=https://portal.example.org
VISION_MODEL_FETCH_ALLOWED_HOSTS=127.0.0.1:3900
VISION_MODEL_CACHE_DIR=/var/lib/pef/vision/model_cache
VISION_WEIGHTS_PATH=/var/lib/pef/vision/weights/active.pt
VISION_UPLOAD_DIR=/var/lib/pef/vision/uploads
TELEMETRY_SPOOL_DIR=/var/lib/pef/vision/spool
