# /etc/pef/web.env (root:pef 0640). Example only: no real value is committed.
WEB_PORT=5000
SESSION_SECRET_KEY=<from the secret manager>
PORTAL_COOKIE_SECURE=true
AUTH_SERVICE_URL=http://127.0.0.1:5001
AUTH_BROWSER_URL=https://portal.example.org
CATALOG_SERVICE_URL=http://127.0.0.1:5003
SESSION_SERVICE_URL=http://127.0.0.1:5004
EVIDENCE_SERVICE_URL=http://127.0.0.1:5005
AUDIT_SERVICE_URL=http://127.0.0.1:5006
NOTIFICATIONS_SERVICE_URL=http://127.0.0.1:5007
MONITORING_SERVICE_URL=http://127.0.0.1:5008
VISION_WORKER_URL=http://127.0.0.1:5002
VISION_WORKER_WS_URL=wss://portal.example.org/ws
VISION_WS_SECRET=<from the secret manager>
MONGO_URL=<mongodb://...>
PEF_OUTBOX_DIR=/var/lib/pef/web/outbox
ADMIN_STORAGE_BACKEND=s3
S3_ENDPOINT=https://s3.example.org
S3_INTERNAL_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_ACCESS_KEY_ID=<from the secret manager>
S3_SECRET_ACCESS_KEY=<from the secret manager>
ADMIN_S3_BUCKET=pef-admin
FRONTEND_DEMO_MODE=false
