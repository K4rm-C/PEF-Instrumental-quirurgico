# /etc/pef/common.env (root:pef 0640). NEVER commit the real file. Values from the secret manager.
DATABASE_URL=postgresql+psycopg://pef_app:<password>@127.0.0.1:5432/pef
REDIS_URL=redis://:<password>@127.0.0.1:6379/0
JWT_SECRET_KEY=<64+ random characters, identical in every service>
JWT_ALGORITHM=HS256
