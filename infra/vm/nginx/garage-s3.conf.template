# MS-09: HTTPS front for Garage's S3 API (Garage itself listens on 127.0.0.1:3900 only and is never exposed).
# Needed only if browsers / clients must reach presigned URLs (S3_PUBLIC_ENDPOINT=https://${PEF_GW_GARAGE_HOST}).
# The Host header is passed unchanged: SigV4 presigned URLs are signed for this host. Garage's admin API (3903) and
# RPC port (3901) are never published.
server {
    listen 443 ssl;
    http2 on;
    server_name ${PEF_GW_GARAGE_HOST};
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    client_max_body_size ${PEF_GW_PORTAL_MAX_BODY};
    access_log /dev/stdout;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location / {
        limit_except GET HEAD PUT POST DELETE { deny all; }
        proxy_pass http://127.0.0.1:3900;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }
}
