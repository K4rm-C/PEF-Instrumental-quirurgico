# Values for scripts/render_gateway_vm.py (VM, no Docker): every upstream is a local systemd service on 127.0.0.1.
PEF_GW_AUTH_UPSTREAM=127.0.0.1:5001
PEF_GW_CATALOG_UPSTREAM=127.0.0.1:5003
PEF_GW_SESSION_UPSTREAM=127.0.0.1:5004
PEF_GW_EVIDENCE_UPSTREAM=127.0.0.1:5005
PEF_GW_NOTIFICATIONS_UPSTREAM=127.0.0.1:5007
PEF_GW_MONITORING_UPSTREAM=127.0.0.1:5008
PEF_GW_INTEGRATION_UPSTREAM=127.0.0.1:5009
PEF_GW_VISION_UPSTREAM=127.0.0.1:5002
PEF_GW_PORTAL_UPSTREAM=127.0.0.1:5000
PEF_GW_RATE_API=20r/s
PEF_GW_BURST_API=40
PEF_GW_RATE_AUTH=10r/m
PEF_GW_BURST_AUTH=5
PEF_GW_MAX_CONN_PER_IP=50
PEF_GW_MAX_BODY=1m
PEF_GW_EVIDENCE_MAX_BODY=10m
PEF_GW_UPSTREAM_TIMEOUT=30s
PEF_GW_WS_TIMEOUT=300s
PEF_GW_PORTAL_MAX_BODY=600m
PEF_GW_PORTAL_TIMEOUT=300s
PEF_GW_RATE_PORTAL=50r/s
PEF_GW_BURST_PORTAL=200
PEF_GW_API_HOST=api.example.org
PEF_GW_PORTAL_HOST=portal.example.org
# MS-11: dynamic re-resolution is only for Docker service names; on the VM the upstreams are fixed loopback
# addresses (and nginx 1.26 has no `resolve`): both stay EMPTY.
PEF_GW_RESOLVER_DIRECTIVE=
PEF_GW_UPSTREAM_RESOLVE=
