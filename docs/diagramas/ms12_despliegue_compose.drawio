servicios → gateway.&lt;br&gt;Puertos: en producción solo el Gateway; los servicios publican 127.0.0.1:50xx para diagnóstico.&lt;br&gt;Pila de pruebas aislada: proyecto pef_ms11 (puertos 26xxx) con HAPI FHIR de pruebas y pesos montados en solo lectura (scripts/compose_ms11.py)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1340" y="200" width="420" height="200" as="geometry"/></mxCell><mxCell id="c25" value="Pesos YOLO: best.pt provisional montado en solo lectura, nunca en el repositorio.&lt;br&gt;Secretos: .env (no versionado); compose.env aleatorio en la pila de pruebas." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1340" y="420" width="420" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
