<mxfile host="PEF-MS12" type="device"><diagram id="ms12_flujo_conteo" name="ms12_flujo_conteo"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="PEF — Flujo de una sesión de conteo: Supervisor → Operador → VisionWorker → EvidenceService" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Supervisor (portal)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="230" height="50" as="geometry"/></mxCell><mxCell id="c4" value="SessionService" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="70" width="230" height="50" as="geometry"/></mxCell><mxCell id="c5" value="Operador (portal)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="70" width="230" height="50" as="geometry"/></mxCell><mxCell id="c6" value="VisionWorker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="910" y="70" width="230" height="50" as="geometry"/></mxCell><mxCell id="c7" value="EvidenceService + Garage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="70" width="230" height="50" as="geometry"/></mxCell><mxCell id="c8" value="NotificationsService" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1490" y="70" width="230" height="50" as="geomet