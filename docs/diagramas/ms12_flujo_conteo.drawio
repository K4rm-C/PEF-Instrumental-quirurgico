20" value="4. Primer fotograma → conteo inicial (referencia)" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="" style="rounded=0;fillColor=#000000;" vertex="1" parent="1"><mxGeometry x="730" y="358" width="10" height="10" as="geometry"/></mxCell><mxCell id="c22" value="" style="rounded=0;fillColor=#000000;" vertex="1" parent="1"><mxGeometry x="1310" y="358" width="10" height="10" as="geometry"/></mxCell><mxCell id="c23" value="5. Checkpoint inicial: JPEG por el outbox (reintento por ventana de tiempo, MS-12)" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="" style="rounded=0;fillColor=#000000;" vertex="1" parent="1"><mxGeometry x="1020" y="410" width="10" height="10" as="geometry"/></mxCell><mxCell id="c25" value="" style="rounded=0;fillColor=#000000;" vertex="1" parent="1"><mxGeometry x="730" y="410" width="10" height="10" as="geometry"/></mxCell><mxCell id="c26" value="6. Video completo: tracking (eventos), último fotograma" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="" style="rounded=0;fillColor=#000000;" vertex="1" parent="1"><mxGeometry x="730" y="462" width="10" height="10" as="geometry"/></mxCell><mxCell id="c28" value="" style="rounded=0;fillColor=#000000;" vertex="1" parent="1"><mxGeometry x="440" y="462" width="10" height="10" as="geometry"/></mxCell><mxCell id="c29" value="7. Conteo final = referencia → aceptado; si no, rechazado (MS-03.1, sin cambios)" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="" style="rounded=0;fillColor=#000000;" vertex="1" parent="1"><mxGeometry x="730" y="514" width="10" heigh