# PEF — environment of `docker compose up -d --build` (GUIA_DOCKER_INTEGRAL.md). Copy to .env (git-ignored)
# and replace every CAMBIAR_* value. Inside Docker the components talk by service name (the compose file
# sets those internal URLs itself); the *_SERVICE_URL / DB_* / *_URL values with 127.0.0.1 below are for
# the host-process development mode (docker-compose.hostdev.yml + the portal / VisionWorker run with Python).
#
# Published ports of the integral deployment. The browser uses WEB_PORT (portal), AUTH_PORT (login
# script) and S3_API_PORT (signed evidence URLs). VISION_PORT is published on 127.0.0.1 only.
WEB_PORT=5000
VISION_PORT=5002

POSTGRES_DB=InstruMed
POSTGRES_USER=pef_user
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_POSTGRES
POSTGRES_PORT=5433

REDIS_PASSWORD=CAMBIAR_PASSWORD_REDIS
REDIS_PORT=6379

MONGO_USER=pef_mongo
MONGO_PASSWORD=CAMBIAR_PASSWORD_MONGO
MONGO_PORT=27017

S3_ACCESS_KEY=CAMBIAR_ACCESS_KEY_GARAGE
S3_SECRET_KEY=CAMBIAR_SECRET_KEY_GARAGE
S3_API_PORT=3900
# Garage RPC / admin host ports (change them when another PEF copy uses 3901/3903).
GARAGE_RPC_PORT=3901
GARAGE_ADMIN_PORT=3903
S3_REGION=garage
# DEPRECATED: no code reads S3_ENDPOINT (kept until the S3 credential/variable cleanup).
S3_ENDPOINT=http://localhost:3900
# Evidence Service. INTERNAL = endpoint the service uses for HEAD/PUT/DELETE (inside docker compose
# it is always http://garage:3900, set in docker-compose.yml); PUBLIC = endpoint a browser/client can
# reach, used to sign download URLs (Phase B).
S3_INTERNAL_ENDPOINT=http://localhost:3900
S3_PUBLIC_ENDPOINT=http://localhost:3900
S3_USE_SSL=false
S3_FORCE_PATH_STYLE=true
S3_BUCKET_EVIDENCE=evidence
S3_BUCKET_PRIVACY=privacy-notices

DATABASE_URL=postgresql+psycopg://pef_user:CAMBIAR_PASSWORD_POSTGRES@localhost:5433/InstruMed
DB_HOST=localhost
DB_PORT=5433
DB_NAME=InstruMed
DB_USER=pef_user
DB_PASSWORD=CAMBIAR_PASSWORD_POSTGRES

REDIS_URL=redis://:CAMBIAR_PASSWORD_REDIS@localhost:6379/0
AUTH_LOGIN_FAIL_TTL_SECONDS=900
AUTH_LOGIN_FAIL_MAX=8

MONGO_URL=mongodb://pef_mongo:CAMBIAR_PASSWORD_MONGO@localhost:27017/?authSource=admin
# PEF-DS06 (checkpoint_frame written by BackendWebFlask, session_telemetry by VisionWorker).
# Empty MONGO_URL disables both writers; counting never depends on MongoDB.
MONGO_DB=pef
MONGO_TIMEOUT_MS=1500
# Durable outbox of pending checkpoints (gitignored instance/ folder by default) and its limit.
PEF_OUTBOX_DIR=
PEF_OUTBOX_MAX_JOBS=500
PEF_EVIDENCE_MAX_ATTEMPTS=30
PEF_EVIDENCE_RETRY_SECONDS=600
# VisionWorker telemetry spool (default apps/VisionWorker/uploads/telemetry_spool) and its limit.
TELEMETRY_SPOOL_DIR=
TELEMETRY_SPOOL_MAX=5000
# EvidenceService URL used by BackendWebFlask to store checkpoint key frames (empty = no evidence).
EVIDENCE_SERVICE_URL=http://127.0.0.1:5005
EVIDENCE_SERVICE_TIMEOUT=5

JWT_SECRET_KEY=CAMBIAR_CLAVE_JWT_LARGA_Y_ALEATORIA
JWT_ALGORITHM=HS256
# Defaults / admin
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_HOURS=8
RESET_TOKEN_MINUTES=30
# SPD: short access, 8h refresh, idle 30m, max wall 12h
SPD_ACCESS_TOKEN_MINUTES=15
SPD_REFRESH_TOKEN_HOURS=8
SPD_IDLE_TIMEOUT_MINUTES=30
SPD_MAX_SESSION_HOURS=12
# OP: short access, 24h refresh, no idle while work_session in_progress, max 24h
OP_ACCESS_TOKEN_MINUTES=15
OP_REFRESH_TOKEN_HOURS=24
OP_MAX_SESSION_HOURS=24
AUTH_RETURN_RESET_TOKEN=true
# POST /register (alta pública sin roles ni auditoría) queda deshabilitada salvo que se active aquí.
AUTH_ENABLE_PUBLIC_REGISTER=false
AUTH_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax
# MS-04: proxies whose X-Forwarded-For AuthService trusts (rate limits, sign-in audit). 0 = header ignored
# (Auth published directly, development). 1 = behind the API Gateway (docker-compose.gateway-tls.yml sets it).
AUTH_TRUSTED_PROXIES=0
HOST=0.0.0.0
PORT=5001

SESSION_SECRET_KEY=CAMBIAR_CLAVE_FLASK_LARGA_Y_ALEATORIA
FRONTEND_DEMO_MODE=false
# Puerto publicado del contenedor `auth` (docker compose up -d auth). Si Auth corre en Docker,
# AUTH_SERVICE_URL / AUTH_BROWSER_URL apuntan a ese puerto; no levantar Auth local a la vez.
AUTH_PORT=5001
AUTH_SERVICE_URL=http://127.0.0.1:5001
# Login script of the browser: open the portal on the SAME host (http://127.0.0.1:5000 with this value),
# the session cookie is bound to it.
AUTH_BROWSER_URL=http://127.0.0.1:5001
AUTH_SERVICE_TIMEOUT=5
# MS-04 (P7): portal cookies. true in production (HTTPS): Secure flag + __Host- prefix on the CSRF cookie.
PORTAL_COOKIE_SECURE=false
# Extra origins allowed to post to the portal (comma separated), e.g. its public HTTPS origin behind a proxy.
CSRF_TRUSTED_ORIGINS=

# MS-04 API Gateway (docker compose --profile gateway; see GUIA_API_GATEWAY.md). Development: HTTP on
# 127.0.0.1:GATEWAY_HTTP_PORT. Production (docker-compose.gateway-tls.yml): the GATEWAY_* names below.
GATEWAY_HTTP_PORT=8080
GATEWAY_RATE_API=20r/s
GATEWAY_BURST_API=40
GATEWAY_RATE_AUTH=10r/m
GATEWAY_BURST_AUTH=5
GATEWAY_RATE_PORTAL=50r/s
GATEWAY_BURST_PORTAL=200
GATEWAY_MAX_CONN_PER_IP=50
GATEWAY_MAX_BODY=1m
GATEWAY_EVIDENCE_MAX_BODY=10m
GATEWAY_UPSTREAM_TIMEOUT=30s
GATEWAY_WS_TIMEOUT=300s
# Production only (TLS): certificate directory (fullchain.pem, privkey.pem) and public names.
# GATEWAY_TLS_CERT_DIR=/etc/pef/certs
# GATEWAY_API_HOST=api.pef.hospital.example
# GATEWAY_PORTAL_HOST=pef.hospital.example
# GATEWAY_PORTAL_ORIGIN=https://pef.hospital.example
# GATEWAY_PORTAL_WS_URL=wss://pef.hospital.example/ws
# GATEWAY_HTTPS_PORT=443
# GATEWAY_HTTP_REDIRECT_PORT=80

# Vision worker (YOLO demo — local process, not Docker)
VISION_WORKER_URL=http://127.0.0.1:5002
VISION_WORKER_TIMEOUT=30
VISION_CONF_DISPLAY_THRESHOLD=0.70
VISION_WORKER_PORT=5002

# Catalog Service (Docker container, docker compose). Local deployment port only;
# not part of the HTTP contract (PEF-DS09 base path is /api/v1/catalog).
CATALOG_PORT=5003
# BackendWebFlask -> CatalogService (families, instruments and kits of the Administration screens).
# Empty = those screens use the in-process admin_local modules (development fallback, never both).
CATALOG_SERVICE_URL=http://127.0.0.1:5003
CATALOG_SERVICE_TIMEOUT=5

# Session Service (Docker container, docker compose). Local deployment port only;
# not part of the HTTP contract (PEF-DS09 base path is /api/v1/sessions).
SESSION_PORT=5004
# BackendWebFlask -> SessionService (Supervisor session operations and screens). Empty = the portal's
# in-process implementation (development fallback, never both). The Operator never uses it.
SESSION_SERVICE_URL=http://127.0.0.1:5004
SESSION_SERVICE_TIMEOUT=5
# Legacy Operator writes of SessionService (410 while false; the Operator flow runs in the portal).
SESSION_OPERATOR_WRITES_ENABLED=false
# Development only: without SESSION_SERVICE_URL, Supervisor Indicators show the old partial local aggregates
# (labeled as development mode). false = a notice instead; Reports always need SessionService.
SUPERVISOR_INDICATORS_LOCAL_FALLBACK=false

# Audit Service (Docker container, docker compose): read API over access_audit / count_event.
AUDIT_PORT=5006
# BackendWebFlask -> AuditService (Administration and Supervisor audit screens). Empty = the portal's
# in-process readers (development fallback). Producers never call it.
AUDIT_SERVICE_URL=http://127.0.0.1:5006
AUDIT_SERVICE_TIMEOUT=5

# Notifications Service (Docker containers notifications + notifications-worker): internal notifications
# of the authenticated user, generated asynchronously from an outbox filled by database triggers.
NOTIFICATIONS_PORT=5007
# BackendWebFlask -> NotificationsService (header bell and /notifications page). Empty = notifications
# disabled in the portal. Nothing else calls it; the Operator's counting never waits on it.
NOTIFICATIONS_SERVICE_URL=http://127.0.0.1:5007
NOTIFICATIONS_SERVICE_TIMEOUT=3
# MS-06 optional e-mail channel of the notifications worker. Disabled unless HOST and FROM are set.
# Never commit real credentials: set USER/PASSWORD only through the deployment's secrets.
# NOTIFICATIONS_SMTP_HOST=
# NOTIFICATIONS_SMTP_PORT=587
# NOTIFICATIONS_SMTP_SECURITY=starttls          # starttls | ssl | none
# NOTIFICATIONS_SMTP_USER=
# NOTIFICATIONS_SMTP_PASSWORD=
# NOTIFICATIONS_SMTP_FROM=
# NOTIFICATIONS_SMTP_TIMEOUT=10
# NOTIFICATIONS_EMAIL_TYPES=discrepancy_pending,review_pending,session_unresolved,station_alert
# NOTIFICATIONS_PORTAL_URL=https://pef.example.org

# Monitoring Service (Docker containers monitoring + monitoring-collector): technical health of every
# component, checked periodically and stored in PostgreSQL (retention MONITORING_RETENTION_DAYS).
MONITORING_PORT=5008
MONITORING_INTERVAL_SECONDS=30
MONITORING_CHECK_TIMEOUT_SECONDS=3
MONITORING_RETENTION_DAYS=7
# MS-05 capture stations: a station without a heartbeat for this long is "without communication" (alert);
# a camera is "working" only if VisionWorker received its frames within MONITORING_CAMERA_FRAMES_SECONDS.
MONITORING_STATION_STALE_SECONDS=90
MONITORING_CAMERA_FRAMES_SECONDS=300
# Targets of the collector (compose DNS names by default; host processes through host.docker.internal).
# MONITORING_TARGET_AUTH_URL=http://auth:5001
# MONITORING_TARGET_WEB_URL=http://host.docker.internal:5000
# MONITORING_TARGET_VISION_URL=http://host.docker.internal:5002
# BackendWebFlask -> MonitoringService (Administration "System status" and the Supervisor's services
# health screen). Empty = those screens show a controlled notice. Nothing else calls it.
MONITORING_SERVICE_URL=http://127.0.0.1:5008
MONITORING_SERVICE_TIMEOUT=3

# Integration Service (MS-07; containers integration + integration-worker): sync API, FHIR R4 read projection and
# FHIR deliveries. INTEGRATION_ALLOWED_HOSTS is EMPTY by default: no FHIR delivery goes anywhere until a destination
# host is explicitly allowed. Never point it at a real hospital system from a development environment.
INTEGRATION_PORT=5009
# SYNC_CURSOR_SECRET=            # optional; derived from JWT_SECRET_KEY when empty
SYNC_CURSOR_MAX_AGE_DAYS=30
SYNC_RETENTION_DAYS=30
INTEGRATION_ALLOWED_HOSTS=
# AuthService: lifetime of machine-client tokens (client credentials, seconds; 60-3600).
AUTH_CLIENT_TOKEN_SECONDS=900

# Evidence Service (Docker container, docker compose). Local deployment port only;
# not part of the HTTP contract (PEF-DS09 base path is /api/v1). Limits are API v1 defaults.
EVIDENCE_PORT=5005
EVIDENCE_SIGNED_URL_TTL_SECONDS=300
EVIDENCE_JPEG_MAX_BYTES=2097152
EVIDENCE_GIF_MAX_BYTES=5242880
# Internal jobs (python -m jobs.purge / jobs.reconcile). Operational settings, not clinical policy:
# rows per purge batch, and minimum age of an unreferenced object before reconciliation may delete it.
EVIDENCE_PURGE_BATCH_SIZE=100
EVIDENCE_ORPHAN_GRACE_SECONDS=3600
ADMIN_DISPLAY_TIMEZONE=America/Mexico_City

# ZIP3 WebSocket preview (use the same signing secret for web and vision).
# Demo only: REPLACE the signing secret with a strong random value before real deployment.
VISION_WS_SECRET=replace-with-long-random-secret
# Local desktop browser: use the configured VisionWorker published host port.
VISION_WORKER_WS_URL=ws://127.0.0.1:5002/ws
VISION_WS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
# Remote deployment requires a TLS reverse proxy for wss:// on the browser-visible host.

# --- Administración (ADMIN-01): almacenamiento de cargas (fotos de familias, avisos de privacidad, pesos .pt) ---
# local (volumen web_admin_storage, por defecto) o s3 (Garage; requiere un bucket que la clave S3 pueda escribir).
ADMIN_STORAGE_BACKEND=local
# Fuera de Docker: carpeta local; por defecto apps/BackendWebFlask/instance/admin_storage (ignorada por git).
# ADMIN_STORAGE_DIR=
ADMIN_S3_BUCKET=pef-admin
# Varias instituciones: UUID de la institución responsable de los catálogos compartidos (familias,
# procedimientos, avisos, modelos). Vacío = cualquier it_admin. Lo aplican el portal y CatalogService.
ADMIN_CATALOG_STEWARD_INSTITUTION_ID=
