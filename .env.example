# Shared MS host venv: apps/.venv-ms + apps/requirements-ms.txt (see scripts/run_ms.ps1)
# Dual deploy: docker-compose.yml = infra for OP-local; docker-compose.integral.yml = full MS stack.
POSTGRES_DB=InstruMed
POSTGRES_USER=MedAdmin
POSTGRES_PASSWORD=MedMin027
POSTGRES_PORT=5433

REDIS_PASSWORD=MedRedis
REDIS_PORT=6379

MONGO_USER=MedAdmin2
MONGO_PASSWORD=MedMongo027
MONGO_PORT=27017

S3_ACCESS_KEY=MedAdmin3
S3_SECRET_KEY=StorageKeySecret027
S3_API_PORT=3900
S3_REGION=garage
S3_ENDPOINT=http://localhost:3900
S3_USE_SSL=false
S3_FORCE_PATH_STYLE=true
S3_BUCKET_EVIDENCE=evidence
S3_BUCKET_PRIVACY=privacy-notices

DATABASE_URL=postgresql+psycopg://MedAdmin:MedMin027@localhost:5433/InstruMed
DB_HOST=localhost
DB_PORT=5433
DB_NAME=InstruMed
DB_USER=MedAdmin
DB_PASSWORD=MedMin027

REDIS_URL=redis://:MedRedis@localhost:6379/0
AUTH_LOGIN_FAIL_TTL_SECONDS=900
AUTH_LOGIN_FAIL_MAX=8

MONGO_URL=mongodb://MedAdmin2:MedMongo027@localhost:27017/?authSource=admin

JWT_SECRET_KEY=InstrumentalCounterKeyPEF
JWT_ALGORITHM=HS256
# Defaults / admin
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_HOURS=8
RESET_TOKEN_MINUTES=30
# SPD: short access, 8h refresh, idle 30m, max wall 12h
SPD_ACCESS_TOKEN_MINUTES=15
SPD_REFRESH_TOKEN_HOURS=8
SPD_IDLE_TIMEOUT_MINUTES=30
SPD_MAX_SESSION_HOURS=12
# OP: short access, 24h refresh, no idle while work_session in_progress, max 24h
OP_ACCESS_TOKEN_MINUTES=15
OP_REFRESH_TOKEN_HOURS=24
OP_MAX_SESSION_HOURS=24
AUTH_RETURN_RESET_TOKEN=true
AUTH_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax
HOST=0.0.0.0
PORT=5001

SESSION_SECRET_KEY=InstrumentalCounterFlaskPEF
FRONTEND_DEMO_MODE=false
AUTH_SERVICE_URL=http://127.0.0.1:5001
AUTH_BROWSER_URL=http://127.0.0.1:5001
AUTH_SERVICE_TIMEOUT=5

# AdminService (apps/AdminService): administration API used by the web portal.
ADMIN_SERVICE_URL=http://127.0.0.1:5003
ADMIN_SERVICE_PORT=5003
ADMIN_SERVICE_TIMEOUT=10
ADMIN_DISPLAY_TIMEZONE=America/Mexico_City

# Vision worker (YOLO demo — local process, not Docker)
VISION_WORKER_URL=http://127.0.0.1:5002
VISION_WORKER_TIMEOUT=30
VISION_CONF_DISPLAY_THRESHOLD=0.70
VISION_WORKER_PORT=5002
VISION_WORKER_WS_URL=ws://127.0.0.1:5002/ws
VISION_WS_SECRET=pef-demo-vision-ws
VISION_WS_TICKET_TTL=300
VISION_WS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
# Rollback de memoria temporal del worker: VISION_TRACK_MEMORY=0
VISION_TRACK_MEMORY=1

# EvidenceWorker (local process): ring 6s, clip 4s+3s MP4; Garage optional
EVIDENCE_QUEUE_ENABLED=1
EVIDENCE_TRIGGER_LIST=pef:evidence:triggers
EVIDENCE_FRAME_LIST_PREFIX=pef:evidence:frames:
EVIDENCE_FRAME_MAX=180
EVIDENCE_RING_SECONDS=6
EVIDENCE_PRE_SECONDS=4
EVIDENCE_POST_SECONDS=3
EVIDENCE_HOURLY_SECONDS=3600
# Sin frames en este gap ⇒ idle (no dispara hourly); catch-up al reanudar
EVIDENCE_IDLE_GAP_SECONDS=30
# PoC: Garage ON (S3 + media_asset PG + checkpoint_frame Mongo). Portal lee BD primero.
EVIDENCE_GARAGE_ENABLED=1
EVIDENCE_MONGO_DB=pef_evidence
EVIDENCE_PRESIGN_EXPIRES=3600
# Tras upload OK borra MP4 local (sidecar queda). Si falla upload → local + cola retry.
EVIDENCE_PURGE_LOCAL_ON_UPLOAD=1
EVIDENCE_UPLOAD_RETRY_LIST=pef:evidence:upload_retry
EVIDENCE_UPLOAD_RETRY_MAX=8
EVIDENCE_UPLOAD_RETRY_POLL_S=15
# Fallback local / pending: apps/EvidenceWorker/clips
# EVIDENCE_CLIPS_DIR=
# Encode: ffmpeg libx264 MP4 → WebM → OpenCV → JPEG
# Windows: .\tools\ensure-ffmpeg.ps1  (o ffmpeg en PATH)
# Hourly ratio: EvidenceWorker consulta VISION_WORKER_URL/sessions/<id>/state
# EVIDENCE_VISION_TIMEOUT=2.5

